export JAVA_HOME="/usr/lib/jvm/graalvm-bin-23/"
export PNPM_HOME="/home/sam/.local/share/pnpm"

export PATH="${PATH}:${HOME}/.cargo/bin"
export PATH=$(echo $PATH | tr ':' '\n' | grep -v '/usr/bin' | tr '\n' ':' | sed 's/:$//'):/usr/bin # Appended to the end therefore set to higher priority.
export PATH="${PATH}:${HOME}/.local/bin"
export PATH="${PATH}:${HOME}/.spicetify"
export PATH="${PATH}:${HOME}/.local/share/ghidra"
export PATH="${PATH}:${HOME}/.local/share/JetBrains/Toolbox/apps"
export PATH="${PATH}:${HOME}/.local/share/JetBrains/Toolbox/bin"
export PATH="${PATH}:${HOME}/.local/share/JetBrains/Toolbox/scripts"
export PATH="${PATH}:/opt/Mullvad VPN/"
export PATH="${PATH}:${PNPM_HOME}"

